generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// PLATFORM USERS & AUTH
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // Platform role key — references Role.key in the Role table.
  // The role's permissions are stored in Role.permissions (JSON array),
  // and can be overridden per-user via UserPermissionOverride rows.
  // Default roles: SUPER_ADMIN_1, SUPER_ADMIN_2, CONSULTANT_1, CONSULTANT_2,
  // COORDINATOR_1, SUPPORT_1, SUPPORT_2, COUPLE
  role         String   @default("CONSULTANT_1")
  avatarUrl         String?
  isActive          Boolean  @default(true)
  mustChangePassword Boolean @default(false)  // true = forced to change password on next login
  resetToken        String?
  resetTokenExpiry  DateTime?
  lastLoginAt       DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWeddings     WeddingAccount[]
  consultantWeddings WeddingAccount[] @relation("ConsultantWeddings")
  coordinatorWeddings WeddingAccount[] @relation("CoordinatorWeddings")
  weddingRoles      UserWeddingRole[]   // Tier 2 + Tier 3 per-wedding roles
  permissionOverrides UserPermissionOverride[]
  auditLogs      AuditLog[]
  notifications  Notification[]
}

// ============================================================
// ROLES (DB-managed, admin can add/edit/delete via Team page)
// ============================================================
// Each role defines a set of permissions (JSON array of permission strings).
// System roles (isSystem: true) cannot be deleted — Super Admin 1, Super Admin 2, Couple.
// All other roles can be edited or deleted by the admin if no users are assigned.
model Role {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "SUPER_ADMIN_1", "CONSULTANT_1"
  label       String              // "Super Admin 1", "Consultant 1"
  tier        String              // "platform" | "wedding_staff" | "account"
  isSystem    Boolean  @default(false)  // true = cannot delete
  permissions String              // JSON array of permission strings, e.g. ["platform:users:manage", "wedding:read"]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// USER PERMISSION OVERRIDES (per-user grant/revoke of individual permissions)
// ============================================================
// Allows the admin to grant or revoke specific permissions on top of the
// user's role. granted=true adds a permission the role doesn't have;
// granted=false removes a permission the role does have.
model UserPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  permission String   // e.g. "platform:users:manage", "wedding:settings:write"
  granted    Boolean  // true = explicitly granted, false = explicitly revoked
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

// ============================================================
// CONTENT TEMPLATES (DB-managed wedding blueprints)
// ============================================================
// A ContentTemplate is a complete wedding blueprint — content text, schedule,
// FAQs, stories, media (URLs), and theme (colors + fonts). When a new couple
// is created, the default template is cloned into their wedding.
// Admins can create/edit/delete templates (including seasonal variants).
// Only one template can be isDefault=true at a time.
model ContentTemplate {
  id          String   @id @default(cuid())
  name        String   @unique  // "Classic Elegance", "Summer Garden"
  description String?
  isDefault   Boolean  @default(false)  // only one can be true
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Complete wedding content stored as JSON strings
  content     String   // JSON: [{section, fieldKey, fieldValue, fieldType}]
  schedule    String   // JSON: [{eventType, title, description, startTime, endTime, location, sortOrder}]
  faqs        String   // JSON: [{question, answer, sortOrder, isActive}]
  stories     String   // JSON: [{title, content, date, imageUrl, sortOrder}]
  media       String   // JSON: [{url, thumbnailUrl, fileName, fileType, category, sortOrder}]
  theme       String   // JSON: {colors: {bg,text,accent,secondary,muted}, fonts: {heading,body}}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// MULTI-TENANT WEDDING ACCOUNTS
// ============================================================

model WeddingAccount {
  id            String   @id @default(cuid())
  slug          String   @unique
  coupleName    String   // "Eleanor & James"
  brideName     String?
  groomName     String?
  weddingDate   DateTime
  weddingTime   String?
  venue         String?
  venueAddress  String?
  googleMapsUrl String?
  status        String   @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED | ARCHIVED | COMPLETED
  plan          String   @default("GOLD")   // GOLD | PLATINUM | DIAMOND
  heroImageUrl   String?
  heroVideoUrl   String?
  bannerUrl      String?
  floorPlanUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Operational fields (Admin CMS)
  jobNumber        String?  @unique  // Internal tracking ID (e.g. DW-TDS-2026-000008)
  coupleEmail      String?  // Couple's email (= login ID for auto-created account)
  couplePhone      String?  // Couple's mobile number
  consultantId     String?  // FK → User (ADMIN_1 / Consultant)
  coordinatorId    String?  // FK → User (ADMIN_2 / Coordinator)
  internalNotes    String?  // Admin-only notes (not visible to couple)
  accessExpiryDate DateTime? // Auto-calculated: weddingDate + couple_access_expiry_days
  accountStatus    String   @default("ONBOARDING") // ONBOARDING | ACTIVE | COMPLETED | EXPIRED | SUSPENDED

  // Theme tracking — true when the couple has manually customized their
  // colors/fonts via the pickers or Diamond Design page. When false, the
  // admin's "Apply Default to All Couples" action will overwrite their
  // theme with the global default template. When true, they're protected.
  themeCustomized  Boolean  @default(false)

  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  consultant  User?  @relation("ConsultantWeddings", fields: [consultantId], references: [id])
  coordinator User?  @relation("CoordinatorWeddings", fields: [coordinatorId], references: [id])
  features  WeddingFeature[]
  content   WeddingContent[]
  media     WeddingMedia[]
  schedules EventSchedule[]
  faqs      FAQ[]
  stories   StoryItem[]
  guests    Guest[]
  seatingTables SeatingTable[]
  seatingHistory SeatingHistory?
  rsvps     RSVPSubmission[]
  wishes    Wish[]
  contacts      ContactSubmission[]
  auditLogs     AuditLog[]
  notifications Notification[]
  members       UserWeddingRole[]   // Tier 2 + Tier 3 per-wedding role assignments
  honeymoonVotes      HoneymoonVote[]
  honeymoonSuggestions HoneymoonSuggestion[]

  // Indexes for Admin CMS search + filter performance at scale
  @@index([coupleName])       // Search by couple name
  @@index([status])           // Filter by status
  @@index([plan])             // Filter by plan
  @@index([createdAt])        // Default ordering (newest first)
  @@index([consultantId])     // Filter by consultant
}

// ============================================================
// PER-WEDDING ROLE ASSIGNMENTS (Tier 2 + Tier 3)
// ============================================================
// Junction table linking a User to a WeddingAccount with a specific
// per-wedding role. This replaces the implicit consultantId/coordinatorId
// FKs on WeddingAccount with a flexible, multi-role model.
//
// Tier 2 (wedding staff, assigned by platform admins):
//   CONSULTANT_1 | CONSULTANT_2 | COORDINATOR
// Tier 3 (account roles, couple-controlled):
//   COUPLE | EDITOR | VIEWER
//
// A user can have multiple rows for the same wedding with different roles
// (rare but allowed). The @@unique constraint prevents duplicate
// (userId, weddingId, role) triples.
model UserWeddingRole {
  id         String         @id @default(cuid())
  userId     String
  weddingId  String
  role       String         // CONSULTANT_1 | CONSULTANT_2 | COORDINATOR | COUPLE | EDITOR | VIEWER
  createdAt  DateTime       @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wedding    WeddingAccount @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@unique([userId, weddingId, role])
  @@index([weddingId])      // List all members of a wedding
  @@index([userId])         // List all weddings a user has access to
}

model WeddingFeature {
  id         String          @id @default(cuid())
  weddingId  String
  wedding    WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  featureKey String          // rsvp | wishes | story | gallery | schedule | qa | moments | getting-there | countdown | music | video
  isEnabled  Boolean         @default(false)
  config     String?         // JSON string for feature-specific settings
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([weddingId, featureKey])
}

model WeddingContent {
  id         String          @id @default(cuid())
  weddingId  String
  wedding    WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  section    String          // hero | schedule | story | rsvp | getting-there | qa | wishes | moments | footer
  fieldKey   String          // title | description | imageUrl | subtitle | address | etc.
  fieldValue String
  fieldType  String          @default("TEXT") // TEXT | RICHTEXT | IMAGE_URL | JSON | NUMBER | BOOLEAN
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([weddingId, section, fieldKey])
}

model WeddingMedia {
  id           String          @id @default(cuid())
  weddingId    String
  wedding      WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  url          String
  thumbnailUrl String?
  fileName     String
  fileType     String          @default("IMAGE") // IMAGE | VIDEO
  fileSize     Int?
  category     String          @default("gallery") // hero | banner | gallery | story | couple-photo
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
}

model EventSchedule {
  id          String          @id @default(cuid())
  weddingId   String
  wedding     WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  eventType   String          // CEREMONY | RECEPTION | DINNER | TEA_CEREMONY | CUSTOM
  title       String
  description String?
  startTime   String          // ISO time string "16:00"
  endTime     String?
  location    String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FAQ {
  id         String          @id @default(cuid())
  weddingId  String
  wedding    WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model StoryItem {
  id         String          @id @default(cuid())
  weddingId  String
  wedding    WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  title      String
  content    String
  date       String?         // display date like "March 2023"
  imageUrl   String?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ============================================================
// GUEST MANAGEMENT
// ============================================================

model Guest {
  id             String          @id @default(cuid())
  weddingId      String
  wedding        WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  groupName      String?         // family/grouping
  tableNumber    Int?
  invitationCode String          @unique
  rsvpStatus     String?         // PENDING | ATTENDING | DECLINED | PARTIAL
  plusOne        Boolean         @default(false)
  plusOneName    String?
  dietaryNotes   String?
  sentVia        String?         // EMAIL | SMS | WHATSAPP | QR | MANUAL
  sentAt         DateTime?
  openedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  rsvps RSVPSubmission[]

  @@index([weddingId])
  @@index([weddingId, tableNumber])
}

// ============================================================
// SEATING ARRANGEMENT (visual canvas tables)
// ============================================================

model SeatingTable {
  id         String          @id @default(cuid())
  weddingId  String
  wedding    WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  tableNum   Int             // Display number (e.g. 1, 2, 3)
  name       String?         // Custom table name (e.g. "VIP Table", "Bride's Family")
  zone       String?         // Zone tag: VIP, BRIDE_FAMILY, GROOM_FAMILY, FRIENDS, COLLEAGUES, CUSTOM
  shape      String          @default("circle") // circle | rectangle | oval
  capacity   Int             @default(8)        // max seats
  posX       Float           @default(100)      // canvas X position
  posY       Float           @default(100)      // canvas Y position
  notes      String?         // e.g. "Near bar", "VIP"
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([weddingId, tableNum])
  @@index([weddingId])
}

// ============================================================
// GUEST-FACING SUBMISSIONS (existing, enhanced with weddingId)
// ============================================================

model RSVPSubmission {
  id        String           @id @default(cuid())
  firstName String
  lastName  String
  partySize Int
  weddingId String?
  wedding   WeddingAccount?  @relation(fields: [weddingId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  guests    GuestResponse[]
  // Guest table relation (if RSVP was from tracked guest)
  guestId   String?
  guest     Guest?           @relation(fields: [guestId], references: [id])
}

model GuestResponse {
  id         String          @id @default(cuid())
  name       String
  attendance String           // "yes" | "no" | "partial"
  dietary    String?
  rsvpId     String
  rsvp       RSVPSubmission  @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model Wish {
  id          String          @id @default(cuid())
  name        String
  relationship String?
  message     String
  imageUrl    String?
  weddingId   String?
  wedding     WeddingAccount? @relation(fields: [weddingId], references: [id])
  createdAt   DateTime        @default(now())
}

model ContactSubmission {
  id        String          @id @default(cuid())
  name      String
  email     String
  contact   String?
  reason    String
  weddingId String?
  wedding   WeddingAccount? @relation(fields: [weddingId], references: [id])
  createdAt DateTime        @default(now())
}

// ============================================================
// AUDIT LOGGING
// ============================================================

model AuditLog {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  weddingId String?
  wedding   WeddingAccount? @relation(fields: [weddingId], references: [id])
  action    String          // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | ACTIVATE | SUSPEND | EXPORT
  entity    String          // User | WeddingAccount | Guest | WeddingFeature | etc.
  entityId  String?
  details   String?         // JSON string with change details
  ipAddress String?
  createdAt DateTime        @default(now())
}

// ============================================================
// SYSTEM CONFIGURATION
// ============================================================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String          @id @default(cuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  weddingId String?
  wedding   WeddingAccount? @relation(fields: [weddingId], references: [id])
  type      String          // RSVP_RECEIVED | WISH_RECEIVED | CONTACT_RECEIVED | GUEST_OPENED | SYSTEM
  title     String
  message   String
  link      String?         // optional deep link within CMS
  isRead    Boolean         @default(false)
  createdAt DateTime        @default(now())
}

// ============================================================
// HONEYMOON VOTING (Story Page live voting)
// ============================================================
model HoneymoonVote {
  id           String          @id @default(cuid())
  weddingId    String
  wedding      WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  destination  String
  voterName    String
  createdAt    DateTime        @default(now())
  @@unique([weddingId, destination, voterName])
  @@index([weddingId])
}

model HoneymoonSuggestion {
  id           String          @id @default(cuid())
  weddingId    String
  wedding      WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  name         String
  suggestedBy  String
  createdAt    DateTime        @default(now())
  @@index([weddingId])
}

// ============================================================
// SEATING CANVAS UNDO/REDO HISTORY (persists across page reloads)
// ============================================================

model SeatingHistory {
  id        String          @id @default(cuid())
  weddingId String          @unique
  wedding   WeddingAccount  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  undoStack String          // JSON array of HistoryEntry snapshots
  redoStack String          // JSON array of HistoryEntry snapshots
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
}